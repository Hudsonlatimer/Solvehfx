# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# APIs
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
ANTHROPIC_API_KEY=your-anthropic-api-key
RESEND_API_KEY=your-resend-api-key

# Email address that receives an alert on every new submission.
# Defaults to hudsonlatimer4@gmail.com if unset.
OWNER_ALERT_EMAIL=hudsonlatimer4@gmail.com

# Shared secret required to call the internal /api/email/dispatch endpoint.
# If unset, that endpoint is disabled (fails closed).
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# Admin (emails allowed into /admin dashboard — comma-separated for multiple).
# Defaults to huddydev0@gmail.com if unset.
NEXT_PUBLIC_ADMIN_EMAIL=huddydev0@gmail.com

# Deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
